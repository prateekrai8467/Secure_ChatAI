# ==============================================================================
# SecureChat AI - Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# NEVER commit the real .env file containing credentials to version control.

PORT=5000
NODE_ENV=development

# Ollama SLM Inference Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=120000

# MongoDB Persistence Settings
MONGODB_URI=mongodb://localhost:27017/securechat_ai

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ML Prompt Injection Detection Microservice
DETECTION_SERVICE_URL=http://127.0.0.1:8000
DETECTION_TIMEOUT_MS=1500
