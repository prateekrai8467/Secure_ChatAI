# ==============================================================================
# SecureChat AI - Master Environment Configuration Example
# ==============================================================================
# Copy this file to .env before starting the project with Docker Compose.
# NEVER commit real production secrets, credentials, or private keys.

# ==============================================================================
# 1. Backend Application Settings
# ==============================================================================
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Ollama SLM Inference Settings
# For Docker on Windows/macOS, use: http://host.docker.internal:11434
# For Linux Docker, use: http://172.17.0.1:11434 (or host.docker.internal via extra_hosts)
# For local bare-metal execution, use: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=120000

# MongoDB Persistence Settings
# For Docker Compose, use container name: mongodb://mongodb:27017/securechat_ai
# For local bare-metal execution, use: mongodb://127.0.0.1:27017/securechat_ai
MONGODB_URI=mongodb://mongodb:27017/securechat_ai

# ==============================================================================
# 2. Machine Learning Detection Microservice Settings
# ==============================================================================
# For Docker Compose, use container name: http://detection-service:8000
# For local bare-metal execution, use: http://127.0.0.1:8000
DETECTION_SERVICE_URL=http://detection-service:8000
DETECTION_TIMEOUT_MS=1500
DETECTION_SERVICE_PORT=8000

# ==============================================================================
# 3. Frontend Settings
# ==============================================================================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5000
